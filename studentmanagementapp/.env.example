# ---- Cấu hình môi trường — COPY file này thành .env rồi điền giá trị thật ----
# .env đã nằm trong .gitignore, KHÔNG commit file đó.

# Database
DATABASE_URL=mysql+pymysql://root:PASSWORD@localhost/studentmanagementdb?charset=utf8mb4

# Secret
SECRET_KEY=doi-o-env-cho-moi-truong
JWT_SECRET_KEY=doi-o-env-cho-moi-truong-cho-du-32-ky-tu-an-toan

# ---- Mail (Gmail SMTP) ----
# Gmail KHÔNG cho phép đăng nhập bằng mật khẩu thường.
# Vào https://myaccount.google.com/apppasswords → tạo App Password (16 ký tự, giữ nguyên dấu cách).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=abcd efgh ijkl mnop
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Đường dẫn gốc dùng trong link trong email
APP_BASE_URL=http://localhost:5001
