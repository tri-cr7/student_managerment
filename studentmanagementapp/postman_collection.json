            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"is_locked\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/users/9/lock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "users",
            "9",
            "lock"
          ]
        },
        "description": "MỤC ĐÍCH: ACADEMIC khóa/mở tài khoản + chốt an toàn.\nTRƯỚC KHI SEND: sửa số 9 trong URL thành user_id thật (lấy từ response request 11).\nKẾT QUẢ ĐÚNG: khóa user thường → 200 {is_locked: true}. Sau đó login user đó → 403.\nCHỐT 1: tự khóa chính mình (lấy id giaovu + token giaovu) → 400 'Không thể tự khóa...'.\nCHỐT 2: khóa ACADEMIC cuối cùng → 422 'phải giữ ít nhất 1 tài khoản Giáo vụ/Admin'.\nMỞ LẠI: đổi body thành {\"is_locked\": false} rồi Send → login lại được 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200/400/422 đều là kết quả hợp lệ của chốt an toàn', () => {",
              "  pm.expect([200, 400, 422]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "14a-Refresh-token (access het 30p)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        },
        "description": "MỤC ĐÍCH: access hết 30p → đổi token mới bằng refresh (sống 7 ngày), không cần login lại.\nCÁCH TEST: mở Authorization, thay {{token}} bằng {{refresh_token}} rồi Send.\nKẾT QUẢ ĐÚNG: 200 + token mới. Refresh sai/hết hạn → 401 login lại.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{refresh_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 + token mới', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.token).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "14b-Forgot-password (xin ma qua mail)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/forgot-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "forgot-password"
          ]
        },
        "description": "MỤC ĐÍCH: quên MK tự phục vụ — nhập email/username → nhận mail OTP 6 SỐ (không còn token dài).\nKẾT QUẢ ĐÚNG: 200 chung cả khi mail đúng/sai (chống enumerate). Xem mã 6 số ở console server (LOGGED) hoặc hộp thư (SUCCESS).\nCopy mã 6 số sang request 14c (otp_code).",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"email\": \"giaovu@school.local\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Luôn 200 (chống enumerate)', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14c-Reset-password (dat lai bang ma)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/reset-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "reset-password"
          ]
        },
        "description": "MỤC ĐÍCH: đặt lại MK bằng OTP 6 số + MK mạnh. Thành công → mở khóa luôn + mail cảnh báo.\nTRƯỚC KHI SEND: thay otp_code bằng 6 số thật từ mail 14b.\nKẾT QUẢ ĐÚNG: 200. OTP sai → 400 'còn N lần'; hết hạn/dùng rồi → 400 'yêu cầu mã mới'; MK yếu → 400.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"email\": \"giaovu@school.local\",\n  \"otp_code\": \"DAN_6_SO_TU_MAIL_14b_VAO_DAY\",\n  \"new_password\": \"MoiManh@123\",\n  \"confirm_password\": \"MoiManh@123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 hoặc 400 đều hợp lệ (tùy mã)', () => {",
              "  pm.expect([200, 400]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "15-Logout",
