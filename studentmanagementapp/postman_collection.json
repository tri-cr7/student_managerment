          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        },
        "description": "MỤC ĐÍCH: đăng xuất (JWT stateless: client tự xóa token, server ghi audit LOGOUT).\nKẾT QUẢ ĐÚNG: 200 'Đăng xuất thành công'. Xong thì xóa biến {{token}} (chuột phải biến → xóa) để test case 'không token → 401'."
      }
    }
